# Server Port
PORT=5000
NODE_ENV=production

# MySQL Database Configuration
DB_HOST=your-mysql-host.example.com
DB_PORT=3306
DB_USER=your_db_username
DB_PASSWORD=your_secure_db_password
DB_NAME=campushire_db

# Security & Authentication
JWT_SECRET=your_random_64_character_hex_jwt_secret
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins (comma separated if multiple)
CORS_ORIGIN=https://your-frontend-deployment.vercel.app,http://localhost:5173
